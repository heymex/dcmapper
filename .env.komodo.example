# Komodo Production Environment Configuration
# Copy this file to your Komodo stack directory as .env

# REQUIRED: Immutable image reference (SHA tag or digest)
# Find available tags at: https://github.com/heymex/dcmapper/pkgs/container/dcmapper
# Example SHA tag: DCMAPPER_IMAGE_TAG=sha-abc1234
# Example with digest: DCMAPPER_IMAGE_TAG=sha-abc1234@sha256:def567890...
# NEVER use 'latest' or mutable semver tags in production!
DCMAPPER_IMAGE_TAG=

# REQUIRED: Domain for Traefik routing
DCMAPPER_DOMAIN=dcmapper.example.com

# REQUIRED: Strong database password
POSTGRES_PASSWORD=

# Optional: Certificate resolver (default: cf)
DCMAPPER_CERT_RESOLVER=cf

# Optional: Admin user name
DCMAPPER_ADMIN_NAME=admin

# Optional: CORS allowed origins
ALLOWED_ORIGINS=https://dcmapper.example.com

# Optional: Rate limiting configuration
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Optional: Auto-create database schema (set to false for production)
DCMAPPER_AUTO_CREATE_SCHEMA=false
